;;           ("mine" :command "/servers/bin/my-server")))

;; What MCP tools may do, unless revere-rules names one.
;; (setopt revere-mcp-rule 'check)

;;;; Routines
;;
;; Routines are Org headings with a repeater in routines.org on the data
;; volume; edit that file over the share rather than here.

;;; local.el ends here
